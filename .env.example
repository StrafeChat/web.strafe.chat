VITE_API_URL=http://localhost:4000
VITE_STARGATE_URL=ws://localhost:4001/events
# No GIF keys here: anything a VITE_ variable holds ends up in the bundle. The API proxies
# GIF search, so set GIPHY_API_KEY / HEYPSTER_API_KEY in equinox's environment instead
# (VITE_GIPHY_API_KEY / VITE_HEYPSTER_API_KEY are no longer read).
